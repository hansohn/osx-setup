# Shared git configuration, symlinked to ~/.gitconfig by install.sh.
#
# Identity is deliberately absent: this repo is public. apps/git.sh derives
# ~/.gitconfig.local from config.sh, and the [include] at the end pulls it in.
# Includes are applied in order, so anything set there wins over this file.

[core]
	editor = vim
	excludesfile = ~/.config/git/ignore
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
[pull]
	rebase = false
[include]
	path = ~/.gitconfig.local
